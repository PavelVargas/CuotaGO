# CuotaGo v1.14.2 - ejemplo seguro para GitHub/Railway
APP_NAME=CuotaGo
APP_VERSION=1.14.2
APP_ENV=production
APP_CURRENCY=DOP
APP_TIMEZONE=America/Santo_Domingo

# Genera/usa un valor largo y aleatorio en Railway.
SECRET_KEY=CHANGE_ME_IN_RAILWAY

# En Railway NO uses localhost. En el servicio web crea una referencia
# a la variable DATABASE_URL del servicio PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
AUTO_CREATE_DB=true
FLASK_DEBUG=false
COOKIE_SECURE=true

# Web Push / PWA
PUSH_NOTIFICATIONS_ENABLED=true
PUSH_SCHEDULER_ENABLED=true
PUSH_CHECK_INTERVAL_MINUTES=5
PUSH_ALERT_START_HOUR=8
PUSH_ALERT_END_HOUR=22
PUSH_OVERDUE_REPEAT_HOURS=4
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=CHANGE_ME_IN_RAILWAY
VAPID_PRIVATE_KEY_B64=CHANGE_ME_IN_RAILWAY

# Superadmin (configura estos valores en Railway; no uses una clave corta)
SUPERADMIN_EMAIL=admin@cuotago.app
SUPERADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SUPERADMIN_NAME=Superadmin
SUPERADMIN_ORG_NAME=CuotaGo Administracion
